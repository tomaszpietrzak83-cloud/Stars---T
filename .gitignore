# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

testdata/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Temporary files in magefile temporary directory
magefiles/mage_output_file.go
magefiles/magefile-debug

tmp/
data/
dist/

.vscode/*.log

.DS_Store

ansible/
frontend/static/images/
frontend/src/lib/wasm/

# Local runtime, saves, caches and audit copies are never published.
.runtime/
audit-results/
*.db
*.db-wal
*.db-shm
*.log
# Ready-to-play Windows edition.
!windows/stars-local.exe
!frontend/static/images/
!frontend/static/images/**
!frontend/src/lib/wasm/
frontend/src/lib/wasm/*
!frontend/src/lib/wasm/cs.wasm

!frontend/src/lib/wasm/wasm_exec.js

frontend/.svelte-kit*/
.audit-tools/
